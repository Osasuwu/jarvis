{
  "mcpServers": {
    "memory": {
      "command": "python",
      "args": ["scripts/run-memory-server.py"]
    },
    "status": {
      "command": "python",
      "args": ["scripts/run-status-server.py"],
      "env": {
        "JARVIS_HOME": "{{JARVIS_HOME}}"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    },
    "obsidian": {
      "command": "npx",
      "args": ["-y", "@bitbonsai/mcpvault@latest", "${OBSIDIAN_VAULT_PATH}"],
      "x-jarvis-requires-env": "OBSIDIAN_VAULT_PATH"
    }
  }
}
